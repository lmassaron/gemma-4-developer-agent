    Turn 06 | Call: write_file -> {'content': 'from fastapi import FastAPI, Body\nfrom pydantic import BaseModel, Field\nfrom typing import Annotated, Union\nfrom fastapi.testclient import TestClient\n\napp = FastAPI()\n\nclass Cat(BaseModel):\n    kind: str = Field("cat", frozen=True)\n    meow: str\n\nclass Dog(BaseModel):\n    kind: str = Field("dog", frozen=True)\n    bark: str\n\n# The issue is about discriminator INSIDE Annotated with Body()\n# In the previous repro, Pet was Annotated[Union[Cat, Dog], Field(discriminator="kind")]\n# And then used as Annotated[Pet, Body()]\n# Which is Annotated[Annotated[Union[Cat, Dog], Field(discriminator="kind")], Body()]\n\n@app.post("/pet")\nasync def create_pet(pet: Annotated[Union[Cat, Dog], Body(discriminator="kind")]):\n    return pet\n\nclient = TestClient(app)\n\ndef test_tagged_union_body():\n    response = client.post("/pet", json={"kind": "cat", "meow": "meow"})\n    print(f"Cat response: {response.status_code} {response.text}")\n    assert response.status_code == 200\n    assert response.json() == {"kind": "cat", "meow": "meow"}\n\n    response = client.post("/pet", json={"kind": "dog", "bark": "bark"})\n    print(f"Dog response: {response.status_code} {response.text}")\n    assert response.status_code == 200\n    assert response.json() == {"kind": "dog", "bark": "bark"}\n\n    response = client.post("/pet", json={"kind": "bird", "tweet": "tweet"})\n    print(f"Bird response: {response.status_code} {response.text}")\n    assert response.status_code == 422\n\nif __name__ == "__main__":\n    import pytest\n    pytest.main([__file__])\n', 'path': '/tmp/repro.py'}
