opes\n\n    @app.get("/multi")\n    def read_multi(\n        scopes: SecurityScopes = Security(dep_inner, scopes=["scope1", "scope2"])\n    ):\n        return {"scopes": scopes.scopes}\n\n    app.dependency_overrides[oauth2_scheme] = lambda: "fake-token"\n    response = client.get("/multi")\n    assert response.status_code == 200\n    assert set(response.json()["scopes"]) == {"scope1", "scope2"}\n', 'path': '/tmp/test_repro.py'}
