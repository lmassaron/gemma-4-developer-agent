    Turn 04 | Call: write_file -> {'content': 'from fastapi import FastAPI, Body\nfrom pydantic import BaseModel, Field\nfrom typing import Union, Annotated\nfrom fastapi.testclient import TestClient\n\napp = FastAPI()\n\nclass Cat(BaseModel):\n    meow: bool\n\nclass Dog(BaseModel):\n    bark: bool\n\n# Tagged union with discriminator\nPet = Annotated[Union[Cat, Dog], Field(discriminator="pet_type")]\n\nclass PetRequest(BaseModel):\n    pet_type: str\n    pet: Pet\n\n@app.post("/pets")\nasync def create_pet(pet: Annotated[Pet, Body()]):\n    return pet\n\nclient = TestClient(app)\n\ndef test_tagged_union_body():\n    # This should work if discriminator is supported in Annotated[..., Body()]\n    response = client.post("/pets", json={"pet_type": "Cat", "meow": True})\n    assert response.status_code == 200\n    assert response.json() == {"meow": True}\n\n    response = client.post("/pets", json={"pet_type": "Dog", "bark": True})\n    assert response.status_code == 200\n    assert response.json() == {"bark": True}\n\n    # Should fail for invalid discriminator\n    response = client.post("/pets", json={"pet_type": "Bird", "fly": True})\n    assert response.status_code == 422\n\nif __name__ == "__main__":\n    test_tagged_union_body()\n', 'path': '/tmp/repro.py'}
